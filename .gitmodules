[submodule "panda"]
  path = panda
  url = https://github.com/sunnyhaibin/panda.git
[submodule "opendbc"]
  path = opendbc_repo
  url = https://github.com/sunnypilot/opendbc.git
[submodule "msgq"]
  path = msgq_repo
  # Fork de commaai/msgq con NUM_READERS 31 (ORBIT tiene 16 lectores de carState; el
  # msgq original solo admite 15 y expulsa a todos al registrarse el 16). Ver
  # tools/orbit/README_commissue_msgq.md
  url = https://github.com/Dragoadri/msgq.git
  branch = orbit
[submodule "rednose_repo"]
  path = rednose_repo
  url = https://github.com/commaai/rednose.git
[submodule "teleoprtc_repo"]
  path = teleoprtc_repo
  url = https://github.com/commaai/teleoprtc
[submodule "tinygrad"]
  path = tinygrad_repo
  url = https://github.com/sunnypilot/tinygrad.git
[submodule "sunnypilot/neural_network_data"]
  path = sunnypilot/neural_network_data
  url = https://github.com/sunnypilot/neural-network-data.git
